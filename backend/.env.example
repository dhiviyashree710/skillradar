# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

SECRET_KEY=change-this-to-a-random-string
JWT_SECRET_KEY=change-this-to-a-different-random-string
DATABASE_URL=sqlite:///instance/skillradar.db

# Comma-separated list of origins allowed to call this API in dev.
CORS_ORIGINS=http://localhost:5173

# Comma-separated emails that get admin access (the Admin Panel screen +
# /api/admin/* routes) on signup or next login. Put your own email here.
ADMIN_EMAILS=you@example.com
